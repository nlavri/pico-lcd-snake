{
  "version": 6,
  "configurePresets": [
    {
      "name": "apps-common",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PICO_SDK_PATH": "$env{HOME}/.pico-sdk/sdk/2.3.1",
        "PICO_TOOLCHAIN_PATH": "$env{HOME}/.pico-sdk/toolchain/15_2_Rel1"
      }
    },
    {
      "name": "apps-pico-debug",
      "displayName": "Applications - Pico (Debug)",
      "inherits": "apps-common",
      "binaryDir": "${sourceDir}/build/apps-pico",
      "cacheVariables": {
        "PICO_BOARD": "pico"
      }
    },
    {
      "name": "apps-picow-debug",
      "displayName": "Applications - Pico W (Debug)",
      "inherits": "apps-common",
      "binaryDir": "${sourceDir}/build/apps-picow",
      "cacheVariables": {
        "PICO_BOARD": "pico_w"
      }
    },
    {
      "name": "apps-picow-spotpear-debug",
      "displayName": "Applications - Pico W + SpotPear 1.54 (Debug)",
      "inherits": "apps-common",
      "binaryDir": "${sourceDir}/build/apps-picow-spotpear",
      "cacheVariables": {
        "PICO_BOARD": "pico_w",
        "APP_HARDWARE": "spotpear_rpi_lcd_1_54",
        "APP_DISPLAY_SPI_BAUDRATE": "62500000"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "apps-pico-debug",
      "configurePreset": "apps-pico-debug"
    },
    {
      "name": "apps-picow-debug",
      "configurePreset": "apps-picow-debug"
    },
    {
      "name": "apps-picow-spotpear-debug",
      "configurePreset": "apps-picow-spotpear-debug"
    }
  ]
}
