{
  "configurations": [
    {
      "name": "Pico",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/.pico-sdk/sdk/2.3.1/**"
      ],
      "compilerPath": "${env:HOME}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gcc",
      "compileCommands": "${workspaceFolder}/build/apps-pico/compile_commands.json",
      "cStandard": "gnu11",
      "cppStandard": "gnu++17",
      "intelliSenseMode": "gcc-arm",
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${env:HOME}/.pico-sdk/sdk/2.3.1"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
