{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pico: Build only",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "cmake --build --preset apps-pico-debug"
    },
    {
      "name": "Pico: Upload via USB (no debug)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "cmake --build --preset apps-pico-debug && /opt/homebrew/bin/picotool load -f -x \"${workspaceFolder}/build/apps-pico/firmware/apps/pico-apps.uf2\""
    },
    {
      "name": "Pico W: Build only",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "cmake --build --preset apps-picow-debug"
    },
    {
      "name": "Pico W: Upload via USB (no debug)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "cmake --build --preset apps-picow-debug && /opt/homebrew/bin/picotool load -f -x \"${workspaceFolder}/build/apps-picow/firmware/apps/pico-apps.uf2\""
    },
    {
      "name": "Pico: Debug with probe",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "request": "launch",
      "type": "cortex-debug",
      "preLaunchTask": "Pico: Build",
      "servertype": "openocd",
      "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
      "device": "RP2040",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${env:HOME}/.pico-sdk/sdk/2.3.1/src/rp2040/hardware_regs/RP2040.svd",
      "runToEntryPoint": "main",
      "overrideLaunchCommands": [
        "monitor reset init",
        "load \"${command:cmake.launchTargetPath}\""
      ],
      "openOCDLaunchCommands": [
        "adapter speed 5000"
      ],
      "searchDir": [
        "/opt/homebrew/share/openocd/scripts"
      ]
    },
    {
      "name": "Doom: Release via USB (no probe)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Doom: Build",
      "command": "/opt/homebrew/bin/picotool load -F -v \"${workspaceFolder}/build/doom-pico/src/doom_tiny_ST7789_240_135.uf2\" && /opt/homebrew/bin/picotool load -v -x -t bin \"${workspaceFolder}/third_party/rp2040-doom-PicoLCD/doom1.whx\" -o 0x10041000 && /usr/bin/python3 \"${workspaceFolder}/scripts/capture_pico_serial.py\" --log \"${workspaceFolder}/build/doom-pico/doom-serial.log\""
    },
    {
      "name": "Doom: Capture USB logs",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "/usr/bin/python3 \"${workspaceFolder}/scripts/capture_pico_serial.py\" --log \"${workspaceFolder}/build/doom-pico/doom-serial.log\""
    },
    {
      "name": "Doom: Debug with probe",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/doom-pico/src/doom_tiny_ST7789_240_135.elf",
      "request": "launch",
      "type": "cortex-debug",
      "preLaunchTask": "Doom: Prepare debug",
      "servertype": "openocd",
      "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
      "device": "RP2040",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${env:HOME}/.pico-sdk/sdk/2.3.1/src/rp2040/hardware_regs/RP2040.svd",
      "runToEntryPoint": "main",
      "overrideLaunchCommands": [
        "monitor reset init",
        "load \"${workspaceFolder}/build/doom-pico/src/doom_tiny_ST7789_240_135.elf\""
      ],
      "openOCDLaunchCommands": [
        "adapter speed 5000"
      ],
      "searchDir": [
        "/opt/homebrew/share/openocd/scripts"
      ]
    }
  ]
}
